{
  "name": "inciteful-zotero-plugin",
  "type": "module",
  "version": "0.3.0",
  "description": "Inciteful Plugin for Zotero",
  "config": {
    "addonName": "Inciteful Zotero Plugin",
    "addonID": "zotero-plugin@inciteful.xyz",
    "addonRef": "incitefulzoteroplugin",
    "addonInstance": "IncitefulZoteroPlugin",
    "prefsPrefix": "extensions.zotero.incitefulzoteroplugin"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/inciteful-xyz/inciteful-zotero-plugin.git"
  },
  "author": "weishuhn",
  "bugs": {
    "url": "https://github.com/inciteful-xyz/inciteful-zotero-plugin/issues"
  },
  "homepage": "https://github.com/inciteful-xyz/inciteful-zotero-plugin#readme",
  "license": "AGPL-3.0-or-later",
  "scripts": {
    "start": "zotero-plugin serve",
    "build": "zotero-plugin build && tsc --noEmit && tsc -p test --noEmit",
    "lint:check": "prettier --check . && eslint .",
    "lint:fix": "prettier --write . && eslint . --fix",
    "release": "zotero-plugin release",
    "test": "zotero-plugin test",
    "update-deps": "npm update --save"
  },
  "dependencies": {
    "zotero-plugin-toolkit": "^5.2.0"
  },
  "devDependencies": {
    "@types/chai": "^5.2.3",
    "@types/mocha": "^10.0.10",
    "@types/node": "^24.10.0",
    "@zotero-plugin/eslint-config": "^0.6.7",
    "chai": "^6.2.1",
    "eslint": "^9.39.2",
    "mocha": "^11.7.5",
    "prettier": "^3.7.4",
    "typescript": "^5.9.3",
    "zotero-plugin-scaffold": "^0.8.8",
    "zotero-types": "^4.1.3"
  },
  "prettier": {
    "printWidth": 80,
    "tabWidth": 2,
    "endOfLine": "lf",
    "overrides": [
      {
        "files": [
          "*.xhtml"
        ],
        "options": {
          "htmlWhitespaceSensitivity": "css"
        }
      }
    ]
  }
}
